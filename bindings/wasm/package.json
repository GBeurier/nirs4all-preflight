{
  "name": "@nirs4all/preflight",
  "version": "0.1.0",
  "description": "Rust NIRS dataset qualification with reusable Methods diagnostics",
  "type": "module",
  "license": "(CECILL-2.1 OR AGPL-3.0-or-later)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GBeurier/nirs4all-preflight.git",
    "directory": "bindings/wasm"
  },
  "homepage": "https://gbeurier.github.io/nirs4all-preflight/",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./native/*": "./native/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native",
    "README.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@nirs4all/methods": "1.3.7",
    "dag-ml-wasm": "0.3.42"
  },
  "scripts": {
    "build:native": "wasm-pack build . --target web --out-dir native --release && node scripts/prepare-native.mjs",
    "test": "node --test --experimental-test-module-mocks tests/*.test.mjs",
    "prepack": "npm run build:native"
  },
  "publishConfig": {
    "access": "public"
  }
}
